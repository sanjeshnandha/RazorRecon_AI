# Copy to .env, or just export these in your shell.
# This matches the docker-compose service.
DATABASE_URL=postgresql://finctl:finctl@localhost:5433/finctl

# Optional: point at a different policy registry.
# POLICY_PATH=./policy/policy.yaml

# ---------------------------------------------------------------------------
# Investigation agent (optional).
#
# The reconciliation is deterministic and needs none of this. The agent only
# reads results the engine already computed and explains them in English; with
# no key set, every other screen works exactly as before and the Ask panel says
# what is missing.
#
# Set ONE of these. Whichever key is present picks the provider.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# XAI_API_KEY=

# Override the provider or model if you want something other than the default
# (gemini-2.5-flash for Gemini, grok-4-fast for Grok):
# FINCTL_LLM_PROVIDER=gemini
# FINCTL_LLM_MODEL=gemini-2.5-pro
# FINCTL_LLM_BASE_URL=
